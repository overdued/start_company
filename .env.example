# 小鲲 KunPeng-Cortex 环境配置
# 复制本文件为 .env 并填入你的 DashScope API Key

# ── API 密钥 ──
# 从 https://dashscope.console.aliyun.com/ 获取
ANTHROPIC_AUTH_TOKEN=sk-你的DashScope-API-Key

# ── API 地址 ──
ANTHROPIC_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── 模型名称 ──
# Qwen 3.7 Plus（文本+视觉多模态一体）
ANTHROPIC_MODEL=qwen3.7-plus
